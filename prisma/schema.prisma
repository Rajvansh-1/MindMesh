// MindMesh Prisma Schema
// SQLite-compatible: no enums (use String with @default)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Auth Models (required by next-auth Prisma adapter) ────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core User Model ──────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("USER")   // USER | ADMIN
  banned        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  ownedRooms      Room[]         @relation("RoomOwner")
  roomMemberships RoomMember[]
  activityLogs    ActivityLog[]
  subscription    Subscription?
}

// ─── Idea Room ────────────────────────────────────────────────────────────

model Room {
  id          String   @id @default(cuid())
  name        String
  description String?
  emoji       String   @default("💡")
  ownerId     String
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner        User             @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members      RoomMember[]
  nodes        Node[]
  edges        Edge[]
  reports      AnalysisReport[]
  simulations  Simulation[]
  activityLogs ActivityLog[]

  @@index([ownerId])
}

model RoomMember {
  id       String   @id @default(cuid())
  roomId   String
  userId   String
  role     String   @default("VIEWER")  // OWNER | EDITOR | VIEWER
  joinedAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
}

// ─── Graph Nodes & Edges ──────────────────────────────────────────────────

model Node {
  id        String   @id @default(cuid())
  roomId    String
  type      String   @default("CUSTOM")  // PROBLEM | SOLUTION | REVENUE | COMPETITOR | MARKET | TEAM | CUSTOM
  label     String
  content   String?
  posX      Float    @default(0)
  posY      Float    @default(0)
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room     Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  asSource Edge[] @relation("SourceNode")
  asTarget Edge[] @relation("TargetNode")

  @@index([roomId])
}

model Edge {
  id        String   @id @default(cuid())
  roomId    String
  sourceId  String
  targetId  String
  label     String?
  animated  Boolean  @default(true)
  createdAt DateTime @default(now())

  room   Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  source Node @relation("SourceNode", fields: [sourceId], references: [id], onDelete: Cascade)
  target Node @relation("TargetNode", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([roomId])
}

// ─── AI Analysis Report ───────────────────────────────────────────────────

model AnalysisReport {
  id                String   @id @default(cuid())
  roomId            String
  strengths         String
  weaknesses        String
  opportunities     String
  threats           String
  riskScore         Int      @default(50)
  marketViability   String   @default("MEDIUM")
  revenueEstimate   String   @default("")
  competitorSummary String   @default("")
  prompt            String?
  createdAt         DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
}

// ─── Simulation ───────────────────────────────────────────────────────────

model Simulation {
  id           String   @id @default(cuid())
  roomId       String
  pricing      Float    @default(29)
  country      String   @default("United States")
  audienceSize Int      @default(10000)
  projections  String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
}

// ─── Subscription ─────────────────────────────────────────────────────────

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  status               String    @default("inactive")
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Activity Log ─────────────────────────────────────────────────────────

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  roomId    String?
  action    String
  metadata  String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  room Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([roomId])
  @@index([createdAt])
}
